# Variables read by docker compose. Copy to .env next to docker-compose.yml.
# Connections (Qdrant, embedding service, language model) are set on the app's Settings page.

# Shared access token for the API (at least 16 characters). Required before exposing
# the web port (WEB_BIND=0.0.0.0) or setting a public SIM_CORS_ORIGINS; the API will
# not start with a public origin and no token.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIM_API_TOKEN=

# Separate API domain (optional). Leave both empty to serve the API under /api on
# the UI's own origin, which needs no CORS.
#   API_URL: public URL of the API, as the browser reaches it.
#   SIM_CORS_ORIGINS: the UI's origin(s), comma-separated or a JSON list.
API_URL=
SIM_CORS_ORIGINS=
# Example:
# API_URL=https://api.sim.example.com
# SIM_CORS_ORIGINS=https://sim.example.com

# Host interface and ports. Everything binds to 127.0.0.1 by default.
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_BIND=127.0.0.1
API_PORT=8000
QDRANT_PORT=6333
