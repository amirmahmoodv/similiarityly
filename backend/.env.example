# Environment for running the API directly (uv run uvicorn ...). All variables use the SIM_ prefix.
#
# Connections are configured on the app's Settings page, not here:
#   Qdrant server, embedding service (OpenAI-compatible), language model.
# They are saved to <SIM_DATA_DIR>/settings.json; SIM_QDRANT_URL, SIM_OPENAI_* and
# SIM_LLM_* are ignored. With nothing saved, the API uses SIM_DEFAULT_QDRANT_URL
# (embedded on-disk Qdrant if empty) and OpenAI's default endpoint.

# Where runtime settings, embedded Qdrant files and downloaded models live.
SIM_DATA_DIR=data

# Qdrant server to use until one is saved on the Settings page. Empty = embedded.
# SIM_DEFAULT_QDRANT_URL=http://localhost:6333

# Optional. Seconds per request to a Qdrant server (default 60).
# SIM_QDRANT_TIMEOUT=60

# Shared access token. Every /api/ request must send "Authorization: Bearer <token>".
# Required whenever the app is reachable from other machines. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIM_API_TOKEN=

# Optional. Only needed when the UI is served from another origin than the API
# (the Vite dev server proxies /api, so local development needs no change).
# Comma-separated or a JSON list, e.g. https://sim.example.com
# SIM_CORS_ORIGINS=http://localhost:5173

# Optional. Upload size limit; keep in step with client_max_body_size in frontend/nginx.conf.
# SIM_MAX_UPLOAD_MB=50
