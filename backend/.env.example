# All settings are prefixed with SIM_. Copy to .env and adjust.
# Qdrant and LLM connections can also be changed in the app's Settings page; values saved
# there go to <SIM_DATA_DIR>/settings.json and override the ones below.

# Where SQLite metadata and (in embedded mode) Qdrant files live.
SIM_DATA_DIR=data

# Qdrant server. Leave empty to use the embedded on-disk Qdrant (single process, dev only).
SIM_QDRANT_URL=http://localhost:6333
SIM_QDRANT_API_KEY=

# OpenAI-compatible embeddings endpoint (OpenAI, Ollama, TEI, vLLM, ...).
SIM_OPENAI_BASE_URL=https://api.openai.com/v1
SIM_OPENAI_API_KEY=

# Chat LLM: "openai" (any OpenAI-compatible API) or "anthropic". Empty base URL = provider default.
SIM_LLM_PROVIDER=openai
SIM_LLM_BASE_URL=
SIM_LLM_API_KEY=
SIM_LLM_MODEL=

# Frontend origins allowed by CORS (JSON list).
SIM_CORS_ORIGINS=["http://localhost:5173"]

# Shared access token. Every /api/ request must send "Authorization: Bearer <token>".
# Required whenever the app is reachable from other machines. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIM_API_TOKEN=
